# Re-run of 01. The first attempt was void through no fault of the robot:
# lap_test defaulted to /diff_drive_base_controller/odom while the xacro
# remaps the controller's odometry to plain /odom, so it recorded 0 samples,
# and auto_drive refused to start because its "nothing sensed yet" sentinel
# was a huge number rather than None. Both fixed and unit-tested.
set -uo pipefail
cd "$ESDA_HOME"
./demo.sh lap igvc_oval_test --seconds 420 \
  --note "baseline re-run after the odom-topic and blind-timeout fixes"
