# wavy and spline never got photographed: their spawn x is negative, and
# `--spawn -5.19,...` is a flag as far as argparse is concerned. The = form
# fixes it. (capture_labelled.py should use that form internally too.)
set -uo pipefail
cd "$ESDA_HOME"
source esda_lib.sh
out="$SCRIPT_DIR/logs/spawn_check"; mkdir -p "$out"
check() {
  stop_all >/dev/null 2>&1; sleep 2
  start_sim "$1" "$2" "$3" "$4" false
  wait_for "/clock ($1)" 90 has_data /clock || { echo "$1 failed"; return; }
  sleep 12
  src
  timeout 50 python3 "$ESDA_SRC/vision/capture_labelled.py" --world "$1" \
      --interval 1.0 --seconds 6 --spawn="$2,$3,$4" \
      --out "$HOME/esda_capture/sp_$1" || true
  f=$(ls -1 "$HOME/esda_capture/sp_$1"/*.jpg 2>/dev/null | tail -1)
  [ -n "$f" ] && cp "$f" "$out/$1.jpg" && echo "saved $out/$1.jpg"
}
check igvc_wavy_test    -5.19 -12.33 2.250
check igvc_spline_test -12.04   8.02 0.839
stop_all >/dev/null 2>&1
ls -la "$out"
