<?xml version="1.0" encoding="UTF-8" ?>
<!--
    For a REMOTE machine (e.g. a laptop running RViz) talking to the Jetson's
    ROS 2 graph over Tailscale. Tailscale doesn't carry multicast, so DDS
    discovery has to be pointed at the Jetson by unicast:

        export FASTRTPS_DEFAULT_PROFILES_FILE=/path/to/fastdds_remote_jetson.xml
        rviz2

    100.67.86.95 is asterius-desktop (the Jetson) on the tailnet. The Jetson
    side needs no change: its participants answer the remote's announcements
    directly. Each participant (one per node) listens for discovery on
    7410 + 2*id in domain 0, so ids 0-49 are listed explicitly - the full
    real-robot launch creates ~30.

    UDP only (no shared memory), matching fastdds_noshm.xml on the Jetson.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastrtps_profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="remote_jetson_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
            <builtin>
                <initialPeersList>
                    <locator><udpv4><address>100.67.86.95</address><port>7410</port></udpv4></locator>
                    <locator><udpv4><address>100.67.86.95</address><port>7412</port></udpv4></locator>
