# Isaac Sim / Isaac Lab generated artefacts.
# USD stages and overlays are regenerated by research/isaac/scripts/*.py;
# checkpoints and logs are large and reproducible. The generated *text*
# assets (esda_robot.urdf, course_meta.yaml) ARE committed, so the WSL side
# gets them on a pull without needing Isaac installed.
research/isaac/usd/
research/isaac/logs/
research/isaac/exported/
research/isaac/assets/meshes/

# Python bytecode. Note: some .pyc files are already tracked in this repo,
# so running tools/validate_waypoint_logic.py dirties the tree. This stops
# new ones appearing; clearing the tracked ones is a separate decision.
__pycache__/
*.pyc

# Isaac task package build artefacts and training runs.
research/isaac/esda_isaac/*.egg-info/
research/isaac/esda_isaac/**/*.egg-info/
